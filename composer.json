{
    "name": "jeffersonrucu/sage-sail",
    "description": "Docker files for running a basic Roots Sage application.",
    "keywords": ["wordpress", "roots", "sage", "sage", "docker"],
    "license": "MIT",
    "support": {
        "issues": "https://github.com/jeffersonrucu/sage-sail/issues",
        "source": "https://github.com/jeffersonrucu/sage-sail"
    },
    "authors": [
        {
            "name": "Jefferson Oliveira",
            "email": "jefferoidtex7@gmail.com"
        }
    ],
    "require": {
        "php": "^8.0",
        "illuminate/console": "^9.52.16|^10.0|^11.0|^12.0",
        "illuminate/contracts": "^9.52.16|^10.0|^11.0|^12.0",
        "illuminate/support": "^9.52.16|^10.0|^11.0|^12.0",
        "symfony/console": "^6.0|^7.0",
        "symfony/yaml": "^6.0|^7.0"
    },
    "require-dev": {
        "orchestra/testbench": "^7.0|^8.0|^9.0|^10.0",
        "phpstan/phpstan": "^2.0"
    },
    "bin": [
        "bin/sail"
    ],
    "autoload": {
        "psr-4": {
            "Laravel\\Sail\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Laravel\\Sail\\SailServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
