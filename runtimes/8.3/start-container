#!/usr/bin/env bash

if [ "$SUPERVISOR_PHP_USER" != "root" ] && [ "$SUPERVISOR_PHP_USER" != "sage" ]; then
    echo "You should set SUPERVISOR_PHP_USER to either 'sage' or 'root'."
    exit 1
fi

if [ ! -z "$WWWUSER" ]; then
    usermod -u $WWWUSER sage
fi

if [ ! -d /.composer ]; then
    mkdir /.composer
fi

chmod -R ugo+rw /.composer

# The socket directory lives on a tmpfs and may be empty on boot...
mkdir -p /run/php

export WEB_ROOT="${WEB_ROOT:-/var/www/html/web}"

if [ ! -d "$WEB_ROOT" ]; then
    echo "Warning: the document root '$WEB_ROOT' does not exist. Set WEB_ROOT to your site's public directory." >&2
fi

# Only WEB_ROOT is substituted so nginx keeps its own variables...
envsubst '${WEB_ROOT}' \
    < /etc/nginx/templates/default.conf.template \
    > /etc/nginx/conf.d/default.conf

if [ $# -gt 0 ]; then
    if [ "$SUPERVISOR_PHP_USER" = "root" ]; then
        exec "$@"
    else
        exec gosu $WWWUSER "$@"
    fi
else
    exec /usr/bin/supervisord -c /etc/supervisor/conf.d/supervisord.conf
fi
