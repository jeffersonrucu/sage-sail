# For more information: https://github.com/jeffersonrucu/sage-sail
services:
    sage.test:
        build:
            context: ./vendor/jeffersonrucu/sage-sail/runtimes/{{PHP_VERSION}}
            dockerfile: Dockerfile
            args:
                WWWGROUP: '${WWWGROUP}'
        image: sage-sail-{{PHP_VERSION}}/app
        extra_hosts:
            - 'host.docker.internal:host-gateway'
        ports:
            - '${APP_PORT:-80}:80'
            - '${VITE_PORT:-5173}:${VITE_PORT:-5173}'
        environment:
            WWWUSER: '${WWWUSER}'
            SAGE_SAIL: 1
            WEB_ROOT: '${WEB_ROOT:-/var/www/html/web}'
            XDEBUG_MODE: '${SAGE_SAIL_XDEBUG_MODE:-off}'
            XDEBUG_CONFIG: '${SAGE_SAIL_XDEBUG_CONFIG:-client_host=host.docker.internal}'
        volumes:
            - '.:/var/www/html'
        networks:
            - sage-sail
networks:
    sage-sail:
        driver: bridge
