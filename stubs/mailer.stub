<?php

/**
 * Plugin Name:  Sage Sail Mailer
 * Description:  Routes outgoing mail through the SMTP service provided by Sage Sail.
 * Author:       Sage Sail
 */

/**
 * Bedrock loads the .env into $_ENV and getenv(), depending on its adapters.
 */
$sage_sail_env = static function (string $key): ?string {
    foreach ([$_ENV, $_SERVER] as $source) {
        if (isset($source[$key]) && $source[$key] !== '') {
            return (string) $source[$key];
        }
    }

    $value = getenv($key);

    return $value === false || $value === '' ? null : $value;
};

$sage_sail_host = $sage_sail_env('SMTP_HOST');

// Stay inert wherever no SMTP service is configured, such as production...
if ($sage_sail_host === null) {
    return;
}

$sage_sail_port = (int) ($sage_sail_env('SMTP_PORT') ?? 1025);

/**
 * WordPress derives the sender from the site host, and PHPMailer rejects a domain
 * without a dot, so mail from "localhost" fails before it is ever sent.
 */
add_filter('wp_mail_from', static function ($from) {
    $domain = substr(strrchr((string) $from, '@') ?: '', 1);

    return str_contains($domain, '.') ? $from : 'wordpress@sage-sail.test';
});

add_action('phpmailer_init', static function ($mailer) use ($sage_sail_host, $sage_sail_port): void {
    $mailer->isSMTP();
    $mailer->Host = $sage_sail_host;
    $mailer->Port = $sage_sail_port;

    // The local mail catcher accepts anything, with no credentials or encryption...
    $mailer->SMTPAuth = false;
    $mailer->SMTPAutoTLS = false;
    $mailer->SMTPSecure = '';
});
